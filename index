<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tutorial: Fade Into You - Mazzy Star</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/mp4-muxer@5.1.3/build/mp4-muxer.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&family=Playfair+Display:ital,wght@1,600&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #09090b;
            color: #fafafa;
            overflow-x: hidden;
        }
        .serif-italic {
            font-family: 'Playfair Display', serif;
            font-style: italic;
        }
        /* Proporção vertical 9:16 */
        .tiktok-container {
            aspect-ratio: 9 / 16;
            max-height: 85vh;
            width: auto;
            max-width: 100%;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col items-center justify-center p-4 bg-gradient-to-br from-zinc-950 via-purple-950/20 to-zinc-950">

    <!-- Container do Vídeo Vertical -->
    <div class="tiktok-container relative bg-zinc-900 rounded-3xl shadow-2xl border border-zinc-800 overflow-hidden flex flex-col justify-between">
        
        <!-- Canvas Principal do Vídeo -->
        <canvas id="tutorialCanvas" class="w-full h-full block"></canvas>

        <!-- Barra de Progresso Discreta no Topo -->
        <div class="absolute top-0 left-0 right-0 h-1 bg-zinc-800/60">
            <div id="progressBar" class="bg-purple-400 h-full w-0 transition-all duration-100"></div>
        </div>

        <!-- Indicador de Renderização (visível apenas ao exportar vídeo) -->
        <div id="recordingBadge" class="hidden absolute top-3 right-3 bg-purple-600/95 backdrop-blur text-white text-[11px] font-bold px-3 py-1 rounded-full flex items-center gap-1.5 shadow-lg">
            <span class="w-2 h-2 rounded-full bg-white animate-pulse"></span>
            <span id="renderStatusText">Rendering 720p...</span>
        </div>

        <!-- Controles na Base -->
        <div class="absolute bottom-0 left-0 right-0 p-4 bg-gradient-to-t from-black/90 via-black/50 to-transparent flex items-center justify-between gap-2">
            <button id="playPauseBtn" class="flex-1 bg-purple-600 hover:bg-purple-500 active:scale-95 transition text-white font-semibold py-2.5 px-3 rounded-xl text-xs flex items-center justify-center gap-1.5 shadow-lg shadow-purple-900/40 cursor-pointer">
                <span id="playIcon">▶</span>
                <span id="playText">Play</span>
            </button>
            <button id="downloadBtn" class="bg-emerald-600 hover:bg-emerald-500 active:scale-95 transition text-white font-semibold py-2.5 px-3 rounded-xl text-xs flex items-center justify-center gap-1.5 shadow-lg shadow-emerald-900/40 cursor-pointer" title="Render and Download Video">
                <span>⬇</span>
                <span id="downloadText">Download Video</span>
            </button>
            <button id="restartBtn" class="bg-zinc-800 hover:bg-zinc-700 active:scale-95 transition text-zinc-200 p-2.5 rounded-xl text-xs cursor-pointer" title="Restart">
                ↺
            </button>
        </div>
    </div>

    <script>
        /**
         * CONFIGURAÇÃO DE ÁUDIO (Tone.js)
         * Sintetiza um timbre suave de violão.
         */
        let synth = null;
        let audioInitialized = false;

        async function initAudio() {
            if (audioInitialized) return;
            await Tone.start();
            
            const reverb = new Tone.Reverb({ decay: 3.5, wet: 0.4 }).toDestination();
            
            synth = new Tone.PolySynth(Tone.Synth, {
                oscillator: { type: "triangle" },
                envelope: {
                    attack: 0.03,
                    decay: 0.8,
                    sustain: 0.2,
                    release: 1.8
                },
                volume: -6
            }).connect(reverb);

            audioInitialized = true;
        }

        // Definição dos acordes de "Fade Into You" (A, E, Bm, D)
        const CHORDS = {
            A: {
                name: 'A',
                fullName: 'A Major',
                notes: ['A2', 'E3', 'A3', 'C#4', 'E4'],
                strings: ['X', '0', '2', '2', '2', '0'],
                fingers: [
                    { string: 4, fret: 2, finger: '1' },
                    { string: 3, fret: 2, finger: '2' },
                    { string: 2, fret: 2, finger: '3' }
                ],
                barre: null,
                color: '#c084fc'
            },
            E: {
                name: 'E',
                fullName: 'E Major',
                notes: ['E2', 'B2', 'E3', 'G#3', 'B3', 'E4'],
                strings: ['0', '2', '2', '1', '0', '0'],
                fingers: [
                    { string: 3, fret: 1, finger: '1' },
                    { string: 5, fret: 2, finger: '2' },
                    { string: 4, fret: 2, finger: '3' }
                ],
                barre: null,
                color: '#818cf8'
            },
            Bm: {
                name: 'Bm',
                fullName: 'B Minor',
                notes: ['B2', 'F#3', 'B3', 'D4', 'F#4'],
                strings: ['X', '2', '4', '4', '3', '2'],
                fingers: [
                    { string: 2, fret: 3, finger: '2' },
                    { string: 4, fret: 4, finger: '3' },
                    { string: 3, fret: 4, finger: '4' }
                ],
                barre: { fret: 2, fromString: 5, toString: 1, finger: '1' },
                color: '#f472b6'
            },
            D: {
                name: 'D',
                fullName: 'D Major',
                notes: ['D3', 'A3', 'D4', 'F#4'],
                strings: ['X', 'X', '0', '2', '3', '2'],
                fingers: [
                    { string: 3, fret: 2, finger: '1' },
                    { string: 1, fret: 2, finger: '2' },
                    { string: 2, fret: 3, finger: '3' }
                ],
                barre: null,
                color: '#38bdf8'
            }
        };

        // Padrão de batida: ↓ . ↓ ↑ . ↑ ↓ ↑
        const STRUM_PATTERN = [
            { dir: '↓', active: true, accent: true },
            { dir: '·', active: false, accent: false },
            { dir: '↓', active: true, accent: false },
            { dir: '↑', active: true, accent: false },
            { dir: '·', active: false, accent: false },
            { dir: '↑', active: true, accent: false },
            { dir: '↓', active: true, accent: true },
            { dir: '↑', active: true, accent: false }
        ];

        // Linha do tempo de 32 segundos
        const TIMELINE = [
            { start: 0, end: 3.5, type: 'intro', title: 'Fade Into You', subtitle: 'Mazzy Star • Quick Guitar Tutorial', tip: 'Standard Tuning (E A D G B E) • ~78 BPM' },
            { start: 3.5, end: 7.0, type: 'chord', chordKey: 'A', step: 'Chord 1 of 4', tip: 'Fingers 1, 2 & 3 together on the 2nd fret' },
            { start: 7.0, end: 10.5, type: 'chord', chordKey: 'E', step: 'Chord 2 of 4', tip: 'Move shape up and strum all 6 strings' },
            { start: 10.5, end: 14.5, type: 'chord', chordKey: 'Bm', step: 'Chord 3 of 4', tip: 'Barre the 2nd fret + Am chord shape' },
            { start: 14.5, end: 18.0, type: 'chord', chordKey: 'D', step: 'Chord 4 of 4', tip: 'Strum only from the 4th to 1st string' },
            { start: 18.0, end: 21.0, type: 'playthrough', chordKey: 'A', label: 'A (1x)' },
            { start: 21.0, end: 24.0, type: 'playthrough', chordKey: 'E', label: 'E (1x)' },
            { start: 24.0, end: 27.0, type: 'playthrough', chordKey: 'Bm', label: 'Bm (1x)' },
            { start: 27.0, end: 30.0, type: 'playthrough', chordKey: 'D', label: 'D (1x)' },
            { start: 30.0, end: 32.0, type: 'outro', title: 'A  →  E  →  Bm  →  D', subtitle: 'Repeat this progression for the whole song!' }
        ];

        // Referências de DOM e Canvas
        const canvas = document.getElementById('tutorialCanvas');
        const ctx = canvas.getContext('2d');
        const playPauseBtn = document.getElementById('playPauseBtn');
        const downloadBtn = document.getElementById('downloadBtn');
        const downloadText = document.getElementById('downloadText');
        const recordingBadge = document.getElementById('recordingBadge');
        const renderStatusText = document.getElementById('renderStatusText');
        const restartBtn = document.getElementById('restartBtn');
        const playIcon = document.getElementById('playIcon');
        const playText = document.getElementById('playText');
        const progressBar = document.getElementById('progressBar');

        let isPlaying = false;
        let isRendering = false;
        let elapsedTime = 0;
        const totalDuration = 32;
        let lastTimestamp = null;
        let lastTriggeredStep = -1;
        let strumVisualPulse = 0;
        let activeStrumIndex = -1;

        function resizeCanvas() {
            const rect = canvas.parentElement.getBoundingClientRect();
            const dpr = window.devicePixelRatio || 1;
            canvas.width = rect.width * dpr;
            canvas.height = rect.height * dpr;
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            renderFrame();
        }
        window.addEventListener('resize', resizeCanvas);

        function strumChord(notes, direction, targetSynth = synth, startTime = Tone.now()) {
            if (!targetSynth) return;
            const orderedNotes = direction === '↑' ? [...notes].reverse() : notes;
            orderedNotes.forEach((note, idx) => {
                targetSynth.triggerAttackRelease(note, '2n', startTime + idx * 0.025);
            });
        }

        // Controles de Reprodução
        playPauseBtn.addEventListener('click', async () => {
            if (isRendering) return;
            await initAudio();
            if (elapsedTime >= totalDuration) {
                elapsedTime = 0;
                lastTriggeredStep = -1;
            }
            isPlaying = !isPlaying;
            updateButtonUI();
            if (isPlaying) {
                lastTimestamp = performance.now();
                requestAnimationFrame(loop);
            }
        });

        restartBtn.addEventListener('click', async () => {
            if (isRendering) return;
            await initAudio();
            elapsedTime = 0;
            lastTriggeredStep = -1;
            isPlaying = true;
            updateButtonUI();
            lastTimestamp = performance.now();
            requestAnimationFrame(loop);
        });

        // Renderização Offline 720x1280 @ 30fps (Rápida e Sem Travamentos)
        downloadBtn.addEventListener('click', async () => {
            if (isRendering) return;

            if (typeof VideoEncoder === 'undefined' || typeof Mp4Muxer === 'undefined') {
                downloadText.textContent = 'Use Chrome/Edge';
                return;
            }

            isRendering = true;
            isPlaying = false;
            updateButtonUI();

            recordingBadge.classList.remove('hidden');
            renderStatusText.textContent = 'Generating Audio...';
            downloadText.textContent = 'Rendering...';
            downloadBtn.classList.add('opacity-60', 'cursor-not-allowed');
            playPauseBtn.classList.add('opacity-50', 'pointer-events-none');
            restartBtn.classList.add('opacity-50', 'pointer-events-none');

            try {
                const width = 720;
                const height = 1280;
                const fps = 30;
                const sampleRate = 44100;
                const totalFrames = totalDuration * fps;

                // 1. Renderiza o áudio completo offline em alta fidelidade
                const audioBuffer = await Tone.Offline(({ transport }) => {
                    const offReverb = new Tone.Reverb({ decay: 3.5, wet: 0.4 }).toDestination();
                    const offSynth = new Tone.PolySynth(Tone.Synth, {
                        oscillator: { type: "triangle" },
                        envelope: { attack: 0.03, decay: 0.8, sustain: 0.2, release: 1.8 },
                        volume: -6
                    }).connect(offReverb);

                    TIMELINE.forEach((seg) => {
                        if (seg.type === 'chord' || seg.type === 'playthrough') {
                            const chord = CHORDS[seg.chordKey];
                            const segDuration = seg.end - seg.start;
                            for (let stepIndex = 0; stepIndex < 8; stepIndex++) {
                                const strum = STRUM_PATTERN[stepIndex];
                                if (strum && strum.active) {
                                    const stepTime = seg.start + (stepIndex / 8) * segDuration;
                                    const orderedNotes = strum.dir === '↑' ? [...chord.notes].reverse() : chord.notes;
                                    orderedNotes.forEach((note, idx) => {
                                        offSynth.triggerAttackRelease(note, '2n', stepTime + idx * 0.025);
                                    });
                                }
                            }
                        }
                    });
                    transport.start();
                }, totalDuration);

                // 2. Configura o Muxer MP4
                const muxer = new Mp4Muxer.Muxer({
                    target: new Mp4Muxer.ArrayBufferTarget(),
                    video: {
                        codec: 'avc',
                        width,
                        height
                    },
                    audio: {
                        codec: 'aac',
                        sampleRate,
                        numberOfChannels: 2
                    },
                    fastStart: 'in-memory'
                });

                // 3. Codifica o Áudio AAC
                const audioEncoder = new AudioEncoder({
                    output: (chunk, meta) => muxer.addAudioChunk(chunk, meta),
                    error: (e) => console.error(e)
                });
                audioEncoder.configure({
                    codec: 'mp4a.40.2',
                    numberOfChannels: 2,
                    sampleRate,
                    bitrate: 128000
                });

                const leftChannel = audioBuffer.getChannelData(0);
                const rightChannel = audioBuffer.numberOfChannels > 1 ? audioBuffer.getChannelData(1) : leftChannel;
                const chunkSize = 1024;
                for (let offset = 0; offset < leftChannel.length; offset += chunkSize) {
                    const frames = Math.min(chunkSize, leftChannel.length - offset);
                    const planar = new Float32Array(frames * 2);
                    planar.set(leftChannel.subarray(offset, offset + frames), 0);
                    planar.set(rightChannel.subarray(offset, offset + frames), frames);

                    const audioData = new AudioData({
                        format: 'f32-planar',
                        sampleRate,
                        numberOfFrames: frames,
                        numberOfChannels: 2,
                        timestamp: Math.round((offset / sampleRate) * 1_000_000),
                        data: planar
                    });
                    audioEncoder.encode(audioData);
                    audioData.close();
                }
                await audioEncoder.flush();

                // 4. Codifica o Vídeo Frame a Frame em 720x1280 @ 30fps
                const candidateConfigs = [
                    { codec: 'avc1.42001f', hardwareAcceleration: 'no-preference' },
                    { codec: 'avc1.4d001f', hardwareAcceleration: 'no-preference' },
                    { codec: 'avc1.42E01E', hardwareAcceleration: 'no-preference' },
                    { codec: 'avc1.4d002a', hardwareAcceleration: 'no-preference' }
                ];

                let selectedVideoConfig = null;
                for (const candidate of candidateConfigs) {
                    const testConfig = {
                        codec: candidate.codec,
                        width,
                        height,
                        bitrate: 3_500_000,
                        framerate: fps,
                        hardwareAcceleration: candidate.hardwareAcceleration
                    };
                    const support = await VideoEncoder.isConfigSupported(testConfig);
                    if (support.supported) {
                        selectedVideoConfig = support.config;
                        break;
                    }
                }

                if (!selectedVideoConfig) {
                    throw new Error('H.264 VideoEncoder is not supported on this browser/device.');
                }

                let encoderError = null;
                const videoEncoder = new VideoEncoder({
                    output: (chunk, meta) => muxer.addVideoChunk(chunk, meta),
                    error: (e) => {
                        encoderError = e;
                        console.error('VideoEncoder error:', e);
                    }
                });
                videoEncoder.configure(selectedVideoConfig);

                const offCanvas = document.createElement('canvas');
                offCanvas.width = width;
                offCanvas.height = height;
                const offCtx = offCanvas.getContext('2d', { alpha: false });
                const logicalW = 360;
                const logicalH = 640;
                offCtx.scale(2, 2);

                let offPulse = 0;
                let offLastStep = -1;
                let offActiveStrum = -1;

                for (let frame = 0; frame < totalFrames; frame++) {
                    if (encoderError || videoEncoder.state === 'closed') {
                        throw encoderError || new Error('VideoEncoder closed unexpectedly.');
                    }

                    // Aguarda a fila esvaziar se houver muitos quadros pendentes
                    while (videoEncoder.encodeQueueSize > 10) {
                        await new Promise(r => setTimeout(r, 5));
                    }

                    const t = frame / fps;
                    const dt = 1 / fps;

                    if (offPulse > 0) offPulse = Math.max(0, offPulse - dt * 4);

                    const seg = TIMELINE.find(s => t >= s.start && t < s.end);
                    if (seg && (seg.type === 'chord' || seg.type === 'playthrough')) {
                        const segDuration = seg.end - seg.start;
                        const segProgress = (t - seg.start) / segDuration;
                        const stepIndex = Math.floor(segProgress * 8);
                        const globalStepId = TIMELINE.indexOf(seg) * 10 + stepIndex;

                        if (globalStepId !== offLastStep && stepIndex < 8) {
                            offLastStep = globalStepId;
                            offActiveStrum = stepIndex;
                            const strum = STRUM_PATTERN[stepIndex];
                            if (strum && strum.active) offPulse = 1.0;
                        }
                    } else {
                        offActiveStrum = -1;
                    }

                    renderScene(offCtx, logicalW, logicalH, t, offPulse, offActiveStrum, true);

                    const videoFrame = new VideoFrame(offCanvas, {
                        timestamp: Math.round(t * 1_000_000),
                        duration: Math.round(dt * 1_000_000)
                    });
                    videoEncoder.encode(videoFrame, { keyFrame: frame % (fps * 2) === 0 });
                    videoFrame.close();

                    if (frame % 15 === 0) {
                        const pct = Math.round((frame / totalFrames) * 100);
                        renderStatusText.textContent = `Rendering 720p: ${pct}%`;
                        progressBar.style.width = `${pct}%`;
                        await new Promise(r => setTimeout(r, 0));
                    }
                }

                renderStatusText.textContent = 'Finalizing MP4...';
                await videoEncoder.flush();
                videoEncoder.close();
                audioEncoder.close();
                muxer.finalize();

                const blob = new Blob([muxer.target.buffer], { type: 'video/mp4' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.style.display = 'none';
                a.href = url;
                a.download = 'fade-into-you-720p.mp4';
                document.body.appendChild(a);
                a.click();
                setTimeout(() => {
                    document.body.removeChild(a);
                    URL.revokeObjectURL(url);
                }, 200);

                progressBar.style.width = `${(elapsedTime / totalDuration) * 100}%`;
            } catch (err) {
                console.error('Export error:', err);
                downloadText.textContent = 'Export Error';
                setTimeout(() => { downloadText.textContent = 'Download Video'; }, 2500);
            } finally {
                isRendering = false;
                recordingBadge.classList.add('hidden');
                downloadText.textContent = 'Download Video';
                downloadBtn.classList.remove('opacity-60', 'cursor-not-allowed');
                playPauseBtn.classList.remove('opacity-50', 'pointer-events-none');
                restartBtn.classList.remove('opacity-50', 'pointer-events-none');
            }
        });

        function updateButtonUI() {
            if (isPlaying) {
                playIcon.textContent = '⏸';
                playText.textContent = 'Pause';
            } else {
                playIcon.textContent = '▶';
                playText.textContent = elapsedTime > 0 && elapsedTime < totalDuration ? 'Resume' : 'Play';
            }
        }

        // Loop Principal de Animação em Tempo Real
        function loop(timestamp) {
            if (!isPlaying) return;

            const dt = (timestamp - lastTimestamp) / 1000;
            lastTimestamp = timestamp;
            elapsedTime += dt;

            if (strumVisualPulse > 0) {
                strumVisualPulse = Math.max(0, strumVisualPulse - dt * 4);
            }

            if (elapsedTime >= totalDuration) {
                elapsedTime = totalDuration;
                isPlaying = false;
                activeStrumIndex = -1;
                updateButtonUI();
                renderFrame();
                return;
            }

            const currentSeg = TIMELINE.find(s => elapsedTime >= s.start && elapsedTime < s.end);
            if (currentSeg && (currentSeg.type === 'chord' || currentSeg.type === 'playthrough')) {
                const segDuration = currentSeg.end - currentSeg.start;
                const segProgress = (elapsedTime - currentSeg.start) / segDuration;
                const stepIndex = Math.floor(segProgress * 8);
                const globalStepId = TIMELINE.indexOf(currentSeg) * 10 + stepIndex;

                if (globalStepId !== lastTriggeredStep && stepIndex < 8) {
                    lastTriggeredStep = globalStepId;
                    activeStrumIndex = stepIndex;
                    const strum = STRUM_PATTERN[stepIndex];
                    if (strum && strum.active) {
                        const chord = CHORDS[currentSeg.chordKey];
                        strumChord(chord.notes, strum.dir);
                        strumVisualPulse = 1.0;
                    }
                }
            } else {
                activeStrumIndex = -1;
            }

            progressBar.style.width = `${(elapsedTime / totalDuration) * 100}%`;
            renderFrame();
            requestAnimationFrame(loop);
        }

        // Renderiza o quadro atual no canvas de visualização
        function renderFrame() {
            const rect = canvas.parentElement.getBoundingClientRect();
            const w = rect.width;
            const h = rect.height;
            if (w === 0 || h === 0) return;

            renderScene(ctx, w, h, elapsedTime, strumVisualPulse, activeStrumIndex, false);
        }

        // Função de Desenho Unificada (usada tanto no preview quanto na exportação 720p)
        function renderScene(targetCtx, w, h, time, pulse, activeStrum, isExportMode) {
            // 1. Fundo atmosférico
            const bgGrad = targetCtx.createLinearGradient(0, 0, 0, h);
            bgGrad.addColorStop(0, '#120c1f');
            bgGrad.addColorStop(0.5, '#191326');
            bgGrad.addColorStop(1, '#09090b');
            targetCtx.fillStyle = bgGrad;
            targetCtx.fillRect(0, 0, w, h);

            // Brilho ambiente suave
            const glowGrad = targetCtx.createRadialGradient(w * 0.5, h * 0.42, 10, w * 0.5, h * 0.42, w * 0.8);
            glowGrad.addColorStop(0, `rgba(168, 85, 247, ${0.14 + pulse * 0.14})`);
            glowGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
            targetCtx.fillStyle = glowGrad;
            targetCtx.fillRect(0, 0, w, h);

            // Partículas flutuantes sutis
            targetCtx.fillStyle = 'rgba(216, 180, 254, 0.16)';
            for (let i = 0; i < 14; i++) {
                const px = ((i * 73 + time * 8) % w);
                const py = ((i * 137 - time * 14 + h * 10) % h);
                targetCtx.beginPath();
                targetCtx.arc(px, py, (i % 3) + 1, 0, Math.PI * 2);
                targetCtx.fill();
            }

            const seg = TIMELINE.find(s => time >= s.start && time < s.end) || TIMELINE[TIMELINE.length - 1];

            // Cabeçalho do Vídeo
            targetCtx.textAlign = 'center';
            targetCtx.fillStyle = 'rgba(255,255,255,0.55)';
            targetCtx.font = '600 11px Inter, sans-serif';
            targetCtx.fillText('HOW TO PLAY • MAZZY STAR', w / 2, 34);

            targetCtx.fillStyle = '#f3e8ff';
            targetCtx.font = 'italic 600 26px "Playfair Display", Georgia, serif';
            targetCtx.fillText('“Fade Into You”', w / 2, 62);

            const contentCenterY = isExportMode ? h * 0.50 : h * 0.46;

            if (seg.type === 'intro') {
                drawIntro(targetCtx, w, h, seg, time);
            } else if (seg.type === 'chord' || seg.type === 'playthrough') {
                drawChordLesson(targetCtx, w, h, contentCenterY, seg, pulse, activeStrum);
            } else if (seg.type === 'outro') {
                drawOutro(targetCtx, w, h, seg);
            }

            // Linha do Tempo de Progressão (A - E - Bm - D)
            if (seg.type !== 'intro') {
                drawProgressionBar(targetCtx, w, h, seg, isExportMode);
            }
        }

        function drawIntro(targetCtx, w, h, seg, time) {
            const centerY = h * 0.48;
            const scale = 1 + Math.sin(time * 3) * 0.025;
            targetCtx.save();
            targetCtx.translate(w / 2, centerY);
            targetCtx.scale(scale, scale);

            targetCtx.fillStyle = 'rgba(192, 132, 252, 0.14)';
            targetCtx.strokeStyle = 'rgba(192, 132, 252, 0.45)';
            targetCtx.lineWidth = 1.5;
            roundRect(targetCtx, -135, -75, 270, 150, 22);
            targetCtx.fill();
            targetCtx.stroke();

            targetCtx.fillStyle = '#e9d5ff';
            targetCtx.font = '800 18px Inter, sans-serif';
            targetCtx.fillText('ONLY 4 CHORDS', 0, -24);

            targetCtx.fillStyle = '#c084fc';
            targetCtx.font = '800 25px Inter, sans-serif';
            targetCtx.fillText('A  •  E  •  Bm  •  D', 0, 14);

            targetCtx.fillStyle = '#a1a1aa';
            targetCtx.font = '500 11px Inter, sans-serif';
            targetCtx.fillText(seg.tip, 0, 48);

            targetCtx.restore();
        }

        function drawChordLesson(targetCtx, w, h, centerY, seg, pulse, activeStrum) {
            const chord = CHORDS[seg.chordKey];
            const topY = centerY - 155;

            // Badge superior
            targetCtx.fillStyle = 'rgba(255,255,255,0.09)';
            roundRect(targetCtx, w / 2 - 68, topY, 136, 24, 12);
            targetCtx.fill();

            targetCtx.fillStyle = '#d4d4d8';
            targetCtx.font = '600 11px Inter, sans-serif';
            targetCtx.fillText(seg.type === 'playthrough' ? 'FULL PLAYTHROUGH' : seg.step.toUpperCase(), w / 2, topY + 16);

            // Nome do Acorde
            targetCtx.fillStyle = chord.color;
            targetCtx.font = '800 54px Inter, sans-serif';
            targetCtx.fillText(chord.name, w / 2, topY + 76);

            targetCtx.fillStyle = '#a1a1aa';
            targetCtx.font = '500 13px Inter, sans-serif';
            targetCtx.fillText(chord.fullName, w / 2, topY + 98);

            // Diagrama do Braço do Violão
            drawFretboard(targetCtx, w / 2, topY + 132, chord, pulse);

            // Padrão de Batida
            drawStrumIndicator(targetCtx, w / 2, topY + 305, chord.color, activeStrum);

            // Dica de execução
            if (seg.tip) {
                targetCtx.fillStyle = '#e4e4e7';
                targetCtx.font = '500 12px Inter, sans-serif';
                targetCtx.fillText(`💡 ${seg.tip}`, w / 2, topY + 356);
            }
        }

        function drawFretboard(targetCtx, centerX, startY, chord, pulse) {
            const boardW = 164;
            const boardH = 144;
            const leftX = centerX - boardW / 2;
            const numStrings = 6;
            const numFrets = 4;
            const stringSpacing = boardW / (numStrings - 1);
            const fretSpacing = boardH / numFrets;

            // Fundo do diagrama
            targetCtx.fillStyle = 'rgba(24, 24, 27, 0.88)';
            targetCtx.strokeStyle = 'rgba(255, 255, 255, 0.14)';
            targetCtx.lineWidth = 1;
            roundRect(targetCtx, leftX - 20, startY - 24, boardW + 40, boardH + 40, 16);
            targetCtx.fill();
            targetCtx.stroke();

            // Pestana superior (Nut)
            targetCtx.fillStyle = '#e4e4e7';
            targetCtx.fillRect(leftX - 2, startY - 3, boardW + 4, 5);

            // Trastes horizontais
            targetCtx.strokeStyle = '#52525b';
            targetCtx.lineWidth = 1.5;
            for (let f = 1; f <= numFrets; f++) {
                const y = startY + f * fretSpacing;
                targetCtx.beginPath();
                targetCtx.moveTo(leftX, y);
                targetCtx.lineTo(leftX + boardW, y);
                targetCtx.stroke();

                targetCtx.fillStyle = '#71717a';
                targetCtx.font = '600 9px Inter, sans-serif';
                targetCtx.fillText(`${f}`, leftX - 12, y - fretSpacing / 2 + 3);
            }

            // Cordas verticais (6ª à 1ª)
            for (let s = 0; s < numStrings; s++) {
                const x = leftX + s * stringSpacing;
                const status = chord.strings[s];

                targetCtx.strokeStyle = status === 'X' ? '#3f3f46' : (pulse > 0.1 ? chord.color : '#a1a1aa');
                targetCtx.lineWidth = 1.2 + (5 - s) * 0.25 + (status !== 'X' ? pulse * 1.4 : 0);
                targetCtx.beginPath();
                targetCtx.moveTo(x, startY);
                targetCtx.lineTo(x, startY + boardH);
                targetCtx.stroke();

                targetCtx.font = '700 11px Inter, sans-serif';
                if (status === 'X') {
                    targetCtx.fillStyle = '#ef4444';
                    targetCtx.fillText('×', x, startY - 8);
                } else if (status === '0') {
                    targetCtx.fillStyle = '#4ade80';
                    targetCtx.fillText('○', x, startY - 8);
                }
            }

            // Pestana (Barre) no Bm
            if (chord.barre) {
                const y = startY + (chord.barre.fret - 0.5) * fretSpacing;
                const x1 = leftX + (6 - chord.barre.fromString) * stringSpacing;
                const x2 = leftX + (6 - chord.barre.toString) * stringSpacing;

                targetCtx.fillStyle = chord.color;
                roundRect(targetCtx, x1 - 9, y - 9, (x2 - x1) + 18, 18, 9);
                targetCtx.fill();

                targetCtx.fillStyle = '#09090b';
                targetCtx.font = '800 11px Inter, sans-serif';
                targetCtx.fillText(chord.barre.finger, (x1 + x2) / 2, y + 4);
            }

            // Bolinhas dos dedos
            chord.fingers.forEach(f => {
                const stringIdx = 6 - f.string;
                const x = leftX + stringIdx * stringSpacing;
                const y = startY + (f.fret - 0.5) * fretSpacing;

                targetCtx.fillStyle = chord.color;
                targetCtx.beginPath();
                targetCtx.arc(x, y, 10, 0, Math.PI * 2);
                targetCtx.fill();

                targetCtx.fillStyle = '#09090b';
                targetCtx.font = '800 11px Inter, sans-serif';
                targetCtx.fillText(f.finger, x, y + 4);
            });
        }

        function drawStrumIndicator(targetCtx, centerX, y, accentColor, activeStrum) {
            const boxW = 246;
            const stepW = boxW / STRUM_PATTERN.length;
            const startX = centerX - boxW / 2;

            targetCtx.fillStyle = 'rgba(255,255,255,0.06)';
            roundRect(targetCtx, startX - 8, y - 16, boxW + 16, 36, 10);
            targetCtx.fill();

            STRUM_PATTERN.forEach((step, idx) => {
                const x = startX + idx * stepW + stepW / 2;
                const isActive = activeStrum === idx && step.active;

                targetCtx.font = isActive ? '800 18px Inter, sans-serif' : '600 14px Inter, sans-serif';
                targetCtx.fillStyle = isActive ? accentColor : (step.active ? '#e4e4e7' : '#52525b');
                targetCtx.fillText(step.dir, x, y + 7);
            });
        }

        function drawProgressionBar(targetCtx, w, h, seg, isExportMode) {
            const chordsOrder = ['A', 'E', 'Bm', 'D'];
            const barY = isExportMode ? h - 55 : h - 88;
            const pillW = 46;
            const gap = 8;
            const totalW = chordsOrder.length * pillW + (chordsOrder.length - 1) * gap;
            const startX = (w - totalW) / 2;

            chordsOrder.forEach((cKey, idx) => {
                const x = startX + idx * (pillW + gap);
                const isCurrent = seg.chordKey === cKey;
                const chordObj = CHORDS[cKey];

                targetCtx.fillStyle = isCurrent ? chordObj.color : 'rgba(39, 39, 42, 0.85)';
                roundRect(targetCtx, x, barY, pillW, 26, 8);
                targetCtx.fill();

                targetCtx.fillStyle = isCurrent ? '#09090b' : '#a1a1aa';
                targetCtx.font = '800 12px Inter, sans-serif';
                targetCtx.fillText(cKey, x + pillW / 2, barY + 17);
            });
        }

        function drawOutro(targetCtx, w, h, seg) {
            const centerY = h * 0.48;
            targetCtx.fillStyle = 'rgba(192, 132, 252, 0.15)';
            targetCtx.strokeStyle = 'rgba(192, 132, 252, 0.45)';
            roundRect(targetCtx, w / 2 - 140, centerY - 65, 280, 130, 20);
            targetCtx.fill();
            targetCtx.stroke();

            targetCtx.fillStyle = '#f3e8ff';
            targetCtx.font = '800 22px Inter, sans-serif';
            targetCtx.fillText(seg.title, w / 2, centerY - 12);

            targetCtx.fillStyle = '#c084fc';
            targetCtx.font = '600 12px Inter, sans-serif';
            targetCtx.fillText(seg.subtitle, w / 2, centerY + 24);
        }

        function roundRect(targetCtx, x, y, width, height, radius) {
            targetCtx.beginPath();
            targetCtx.moveTo(x + radius, y);
            targetCtx.lineTo(x + width - radius, y);
            targetCtx.quadraticCurveTo(x + width, y, x + width, y + radius);
            targetCtx.lineTo(x + width, y + height - radius);
            targetCtx.quadraticCurveTo(x + width, y + height, x + width - radius, y + height);
            targetCtx.lineTo(x + radius, y + height);
            targetCtx.quadraticCurveTo(x, y + height, x, y + height - radius);
            targetCtx.lineTo(x, y + radius);
            targetCtx.quadraticCurveTo(x, y, x + radius, y);
            targetCtx.closePath();
        }

        window.addEventListener('load', () => {
            resizeCanvas();
        });
    </script>
</body>
</html>
